[node name="BotSpawnPoint" parent="Bots" unique_id=1630670093 instance=ExtResource("15_sbo1b")]
position = Vector2(1129, 566)
bot_name = "Old Thomas"
bot_class = "miner"
wander_radius = 200.0
dialogue_pool = "The mine's been good to us lately.
Remember when the cave collapsed? Dark times.
I've been mining these hills for forty years.
The youngsters don't know real work anymore."

[node name="BotSpawnPoint2" parent="Bots" unique_id=115174850 instance=ExtResource("15_sbo1b")]
position = Vector2(673, 808)
bot_name = "Martha"
wander_radius = 180.0
appearance_head_id = "head_b"
dialogue_pool = "The herbs are blooming beautifully this season.
Have you tried the stew at the tavern?
My grandmother taught me everything about plants.
Be careful near the forest edge..."

[node name="BotSpawnPoint3" parent="Bots" unique_id=1787439520 instance=ExtResource("15_sbo1b")]
position = Vector2(660, 592)
bot_name = "Young Erik"
bot_class = "trapper"
appearance_head_id = "head_c"
dialogue_pool = "Caught three rabbits yesterday!
The wolves have been coming closer lately.
Anyone seen my hunting knife?
I heard there's treasure in the old ruins."

[node name="BotSpawnPoint4" parent="Bots" unique_id=1846727976 instance=ExtResource("15_sbo1b")]
position = Vector2(40, 249)
bot_name = "Grandmother Willow"
wander_radius = 120.0
dialogue_pool = "Back in my day, we had real adventures.
The market prices are too high these days.
Have you paid your respects at the shrine?
My bones ache... rain is coming."

