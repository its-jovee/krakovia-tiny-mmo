[sub_resource type="Shader" id="Shader_pmgut"]
code = "shader_type canvas_item;

uniform sampler2D grass_texture : hint_default_white;
uniform float uv_scale : hint_range(0.5, 10.0) = 2.0;
uniform float brightness : hint_range(0.0, 2.0) = 1.0;
uniform float contrast : hint_range(0.0, 2.0) = 1.0;

void fragment() {
    // Repetir a textura de forma contínua sem resetar em cada tile
    vec2 uv = UV * uv_scale;
    
    vec4 grass = texture(grass_texture, uv);
    
    // Aplicar contraste
    grass.rgb = mix(vec3(0.5), grass.rgb, contrast);
    
    // Aplicar brilho
    grass.rgb *= brightness;
    
    COLOR = grass;
}"

